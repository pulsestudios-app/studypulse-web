# StudyPulse Web — public build-time config.
# Every value here is PUBLIC: it is compiled into the JS bundle that anyone can read.
# Never put a service-role key, Sentry auth token, or any other secret in a VITE_* variable.
# CI reads these from GitHub repository *Variables* (Settings → Secrets and variables → Actions → Variables).

# Supabase project (same as the phone app). Anon key only — RLS enforces access.
VITE_SUPABASE_URL=https://uhfavszrclwwwnimxsbr.supabase.co
VITE_SUPABASE_ANON_KEY=

# Railway backend. For local dev use the Vite proxy (/backend) so no localhost CORS entry is needed.
# Production: https://studypulse-production.up.railway.app
VITE_BACKEND_URL=/backend
# Optional: proxy target for `npm run dev` (defaults to production Railway).
# VITE_BACKEND_PROXY_TARGET=https://studypulse-production.up.railway.app

# Public x-app-key, same value the phone app and pulsestudios.app/upload ship.
VITE_APP_KEY=

# Analytics (optional — both are disabled when empty).
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=
# Sentry environment tag; the phone's Sentry project is shared, so web events are tagged "web".
VITE_SENTRY_ENVIRONMENT=web
